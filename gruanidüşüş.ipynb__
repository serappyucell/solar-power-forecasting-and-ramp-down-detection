1b[37m\u001b[0m \u001b[1m24s\u001b[0m 14ms/step - loss: 0.0023 - val_loss: 0.0023\n","Epoch 19/20\n","\u001b[1m1752/1752\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m41s\u001b[0m 14ms/step - loss: 0.0024 - val_loss: 0.0022\n","Epoch 20/20\n","\u001b[1m1752/1752\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m40s\u001b[0m 13ms/step - loss: 0.0022 - val_loss: 0.0024\n"]},{"output_type":"execute_result","data":{"text/plain":["<keras.src.callbacks.history.History at 0x793a76b44f10>"]},"metadata":{},"execution_count":8}]},{"cell_type":"code","source":["# Tahmin\n","pred_gru = model_gru.predict(X_test)\n","pred_gru_inv = scaler.inverse_transform(pred_gru)\n","actual_inv = scaler.inverse_transform(y_test)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0dqNamgveBd1","executionInfo":{"status":"ok","timestamp":1746634190296,"user_tz":-180,"elapsed":1331,"user":{"displayName":"Serap Yücel","userId":"10389006341169284479"}},"outputId":"db01e99b-3af7-4c2d-9247-4b2d302276b1"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[1m219/219\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 4ms/step\n"]}]},{"cell_type":"code","source":["# Metrikler\n","mse = mean_squared_error(actual_inv, pred_gru_inv)\n","rmse = np.sqrt(mse)\n","mae = mean_absolute_error(actual_inv, pred_gru_inv)\n","r2 = r2_score(actual_inv, pred_gru_inv)\n","\n","print(\"🔷 GRU Model Performansı:\")\n","print(f\"R²: {r2:.4f}\")\n","print(f\"MAE: {mae:.2f}\")\n","print(f\"MSE: {mse:.2f}\")\n","print(f\"RMSE: {rmse:.2f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zr9VoqsHeFl6","executionInfo":{"status":"ok","timestamp":1746634192148,"user_tz":-180,"elapsed":3,"user":{"displayName":"Serap Yücel","userId":"10389006341169284479"}},"outputId":"45510c55-d2ca-4363-c623-2a98df6ae667"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["🔷 GRU Model Performansı:\n","R²: 0.9696\n","MAE: 11.13\n","MSE: 503.31\n","RMSE: 22.43\n"]}]},{"cell_type":"code","source":["# Grafik\n","plt.figure(figsize=(14,6))\n","plt.plot(actual_inv, label='Gerçek Üretim')\n","plt.plot(pred_gru_inv, label='GRU Tahmini')\n","plt.title('GRU: Gerçek vs Tahmin')\n","plt.xlabel('Zaman')\n","plt.ylabel('Üretim (kW)')\n","plt.legend()\n","plt.grid(True)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":564},"id":"6E71FfCQeJHw","executionInfo":{"status":"ok","timestamp":1746634196693,"user_tz":-180,"elapsed":1048,"user":{"displayName":"Serap Yücel","userId":"10389006341169284479"}},"outputId":"8f51fcec-42b8-4505-8f83-35c55d435286"},"execution_count":11,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Ani üretim düşüşü\n","threshold = 150\n","print(\"\\n🔻 GRU ile Ani Üretim Düşüşleri:\")\n","for i in range(len(actual_inv)):\n","    fark = pred_gru_inv[i] - actual_inv[i]\n","    if fark > threshold:\n","        zaman = df.index[train_size + i + window_size]\n","        print(f\"Saat: {zaman}, Tahmin - Gerçek = {fark[0]:.2f} kW\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"66fBVhCNeLuM","executionInfo":{"status":"ok","timestamp":1746634200175,"user_tz":-180,"elapsed":9,"user":{"displayName":"Serap Yücel","userId":"10389006341169284479"}},"outputId":"e671330e-ca22-463e-9717-b8e2120629fa"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","🔻 GRU ile Ani Üretim Düşüşleri:\n","Saat: 2022-03-18 13:00:00, Tahmin - Gerçek = 174.19 kW\n","Saat: 2022-03-22 11:00:00, Tahmin - Gerçek = 276.82 kW\n","Saat: 2022-03-26 14:00:00, Tahmin - Gerçek = 166.83 kW\n","Saat: 2022-04-11 12:00:00, Tahmin - Gerçek = 184.73 kW\n","Saat: 2022-05-01 15:00:00, Tahmin - Gerçek = 164.37 kW\n","Saat: 2022-05-12 13:00:00, Tahmin - Gerçek = 195.53 kW\n","Saat: 2022-05-25 14:00:00, Tahmin - Gerçek = 156.75 kW\n","Saat: 2022-06-16 12:00:00, Tahmin - Gerçek = 347.24 kW\n","Saat: 2022-06-24 13:00:00, Tahmin - Gerçek = 291.77 kW\n","Saat: 2022-06-24 14:00:00, Tahmin - Gerçek = 172.47 kW\n","Saat: 2022-09-22 13:00:00, Tahmin - Gerçek = 160.44 kW\n","Saat: 2022-09-24 13:00:00, Tahmin - Gerçek = 162.99 kW\n","Saat: 2022-10-02 09:00:00, Tahmin - Gerçek = 201.48 kW\n"]}]}]}